{
  "components": {
    "schemas": {
      "AdminMe": {
        "additionalProperties": false,
        "description": "The authenticated pilot administrator (``GET /api/v1/auth/me``).",
        "properties": {
          "administrator_id": {
            "title": "Administrator Id",
            "type": "integer"
          },
          "organization_id": {
            "title": "Organization Id",
            "type": "integer"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "administrator_id",
          "organization_id",
          "username"
        ],
        "title": "AdminMe",
        "type": "object"
      },
      "DeviceOut": {
        "additionalProperties": false,
        "description": "A registered edge device; credentials are never exposed.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "device_id": {
            "title": "Device Id",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "organization_id": {
            "title": "Organization Id",
            "type": "integer"
          },
          "production_line_id": {
            "title": "Production Line Id",
            "type": "integer"
          },
          "site_id": {
            "title": "Site Id",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "organization_id",
          "site_id",
          "production_line_id",
          "device_id",
          "name",
          "status",
          "created_at"
        ],
        "title": "DeviceOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthLive": {
        "additionalProperties": false,
        "description": "Liveness response; never blocks on dependencies.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthLive",
        "type": "object"
      },
      "LineOut": {
        "additionalProperties": false,
        "description": "A production line within the administrator's organization.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "organization_id": {
            "title": "Organization Id",
            "type": "integer"
          },
          "site_id": {
            "title": "Site Id",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "site_id",
          "organization_id",
          "name",
          "created_at"
        ],
        "title": "LineOut",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "description": "RFC 7807 error body (contract 05 section 6).\n\n``request_id`` correlates the response with the request log; ``errors``\ncarries bounded per-field validation details. Credentials, object keys,\ninternal paths, SQL, and stack traces are never included.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "title": "Errors",
            "type": "array"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "request_id",
          "errors"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ReadinessReport": {
        "additionalProperties": false,
        "description": "Readiness response naming each checked dependency.\n\n``checks`` maps dependency names to ``\"ok\"`` only; failure details are\nreturned through the RFC 7807 problem body of the 503 response.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessReport",
        "type": "object"
      },
      "SiteOut": {
        "additionalProperties": false,
        "description": "A production site within the administrator's organization.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "organization_id": {
            "title": "Organization Id",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "organization_id",
          "name",
          "created_at"
        ],
        "title": "SiteOut",
        "type": "object"
      },
      "UploadReceiptOut": {
        "additionalProperties": false,
        "description": "Verified central receipt for one accepted edge upload (task C1 5.3).\n\nEvery field is echoed from the request so the edge scheduler can validate\nthe receipt against the payload it actually sent; a MEDIA receipt always\ncarries a non-empty ``central_object_id`` (C2b), which is null for\nINSPECTION receipts.",
        "properties": {
          "central_object_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Central Object Id"
          },
          "checksum_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checksum Sha256"
          },
          "idempotency_key": {
            "title": "Idempotency Key",
            "type": "string"
          },
          "kind": {
            "enum": [
              "INSPECTION",
              "MEDIA"
            ],
            "title": "Kind",
            "type": "string"
          },
          "object_id": {
            "title": "Object Id",
            "type": "string"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "idempotency_key",
          "object_id",
          "kind",
          "checksum_sha256",
          "size_bytes"
        ],
        "title": "UploadReceiptOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "PilotBearer": {
        "description": "Pilot administrator bearer credential (or a short-lived browser session cookie exchanged via POST /auth/session)",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "AssemblyVision Central API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/me": {
      "get": {
        "description": "Return the authenticated pilot administrator identity.",
        "operationId": "get_me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminMe"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A valid pilot administrator credential or session is required"
          }
        },
        "security": [
          {
            "PilotBearer": []
          }
        ],
        "summary": "Get Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/session": {
      "post": {
        "description": "Exchange a pilot administrator bearer credential for a session cookie.",
        "operationId": "create_admin_session_api_v1_auth_session_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A valid pilot administrator credential or session is required"
          }
        },
        "security": [
          {
            "PilotBearer": []
          }
        ],
        "summary": "Create Admin Session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/devices": {
      "get": {
        "operationId": "list_devices_api_v1_devices_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DeviceOut"
                  },
                  "title": "Response List Devices Api V1 Devices Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A valid pilot administrator credential or session is required"
          }
        },
        "security": [
          {
            "PilotBearer": []
          }
        ],
        "summary": "List Devices",
        "tags": [
          "tenant"
        ]
      }
    },
    "/api/v1/devices/{device_row_id}": {
      "get": {
        "operationId": "get_device_api_v1_devices__device_row_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "device_row_id",
            "required": true,
            "schema": {
              "title": "Device Row Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A valid pilot administrator credential or session is required"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The requested resource does not exist in this organization"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "PilotBearer": []
          }
        ],
        "summary": "Get Device",
        "tags": [
          "tenant"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "description": "Process liveness only; never blocks on dependencies.",
        "operationId": "health_live_api_v1_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLive"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Live",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Report readiness, failing closed when any dependency is unavailable.",
        "operationId": "health_ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReport"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/inspection-uploads": {
      "post": {
        "description": "Ingest one edge inspection or media upload and return a receipt.",
        "operationId": "inspection_uploads_api_v1_inspection_uploads_post",
        "responses": {
          "200": {
            "description": "Identical replay; the original verified receipt is returned"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadReceiptOut"
                }
              }
            },
            "description": "New valid inspection persisted with a verified receipt"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A valid device upload credential is required"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The payload device does not match the authenticated device"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Payload conflict: a reused identity carried different content"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The envelope or payload exceeds the configured limit"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Malformed, invalid, or identity-mismatched envelope or payload"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The object store could not accept the media; retryable"
          }
        },
        "summary": "Inspection Uploads",
        "tags": [
          "ingest"
        ]
      }
    },
    "/api/v1/lines": {
      "get": {
        "operationId": "list_lines_api_v1_lines_get",
        "parameters": [
          {
            "in": "query",
            "name": "site_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Site Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LineOut"
                  },
                  "title": "Response List Lines Api V1 Lines Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A valid pilot administrator credential or session is required"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "PilotBearer": []
          }
        ],
        "summary": "List Lines",
        "tags": [
          "tenant"
        ]
      }
    },
    "/api/v1/sites": {
      "get": {
        "operationId": "list_sites_api_v1_sites_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SiteOut"
                  },
                  "title": "Response List Sites Api V1 Sites Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A valid pilot administrator credential or session is required"
          }
        },
        "security": [
          {
            "PilotBearer": []
          }
        ],
        "summary": "List Sites",
        "tags": [
          "tenant"
        ]
      }
    }
  }
}
