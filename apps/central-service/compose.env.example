# Copy to `.env` (Compose reads it automatically), then set every required
# value to a unique deployment secret. Empty values are intentional: Compose
# fails closed until they are supplied. Never commit real secrets.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=
CENTRAL_ADMIN_TOKEN=
CENTRAL_DEVICE_UPLOAD_TOKEN=
# Dev-only opt-out for plain-HTTP loopback browsing; production must keep true.
CENTRAL_SECURE_COOKIES=false
# Pilot hardening (C6): per-client request cap per minute; 0 disables. Health
# endpoints are never limited. Override only with measured pilot traffic.
CENTRAL_RATE_LIMIT_REQUESTS_PER_MINUTE=600
ADMIN_WEB_PORT=8080
