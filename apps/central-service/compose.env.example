# Development-only defaults for the central pilot Compose deployment.
# Copy to `.env` (Compose reads it automatically) and override every value
# for any non-local deployment. Never commit real secrets.
POSTGRES_USER=central
POSTGRES_PASSWORD=assemblyvision-dev
POSTGRES_DB=assemblyvision
MINIO_ROOT_USER=assemblyvision-dev
MINIO_ROOT_PASSWORD=assemblyvision-dev
MINIO_BUCKET=assemblyvision-central
# Replace these with unique secrets for any non-local deployment; the Compose
# bootstrap fails closed when they are unset.
CENTRAL_ADMIN_TOKEN=assemblyvision-admin-dev
CENTRAL_DEVICE_UPLOAD_TOKEN=assemblyvision-device-dev
# Dev-only opt-out for plain-HTTP loopback browsing; production must keep true.
CENTRAL_SECURE_COOKIES=false
# Pilot hardening (C6): per-client request cap per minute; 0 disables. Health
# endpoints are never limited. Override only with measured pilot traffic.
CENTRAL_RATE_LIMIT_REQUESTS_PER_MINUTE=600
ADMIN_WEB_PORT=8080
